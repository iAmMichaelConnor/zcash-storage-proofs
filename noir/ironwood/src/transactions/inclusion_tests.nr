fn nf(action: [u8; 148]) -> [u8; 32] {
    let mut out = [0u8; 32];
    for i in 0..32 {
        out[i] = action[i];
    }
    out
}
#[test]
fn two_action_transaction_verifies_at_exact_capacity() {
    let (a, txid) = verify_action(witness_2(1, 2), HASH);
    assert(txid == TXID);
    assert(a.nullifier == nf(ACTION_1));
}
#[test]
fn two_action_transaction_verifies_each_action_in_capacity_four() {
    let (a0, t0) = verify_action(witness_4(0, 2), HASH);
    let (a1, t1) = verify_action(witness_4(1, 2), HASH);
    assert((t0 == TXID) & (t1 == TXID));
    assert(a0.nullifier == nf(ACTION_0));
    assert(a1.nullifier == nf(ACTION_1));
    verify_nullifier_inclusion(witness_4(1, 2), nf(ACTION_1), HASH);
}
// The same relation on witness values (std::hint::black_box), so it is not
// folded at compile time.
#[test]
fn nullifier_inclusion_with_witness_inputs() {
    verify_nullifier_inclusion(
        black_box(witness_2(1, 2)),
        black_box(nf(ACTION_1)),
        black_box(HASH),
    );
}
#[test(should_fail_with = "Nonzero bounded hash padding")]
fn truncated_action_count_rejects() {
    let _ = verify_action(witness_4(0, 1), HASH);
}
#[test(should_fail_with = "Transaction Merkle root mismatch")]
fn dropped_action_rejects() {
    let mut w = witness_4(0, 1);
    w.effects.compact_actions[1] = [0u8; 148];
    let _ = verify_action(w, HASH);
}
#[test(should_fail_with = "Transaction Merkle root mismatch")]
fn extra_zero_action_rejects() {
    let _ = verify_action(witness_4(0, 3), HASH);
}
#[test(should_fail_with = "Action index outside complete sequence")]
fn action_index_past_count_rejects() {
    let _ = verify_action(witness_4(2, 2), HASH);
}
#[test(should_fail_with = "Inclusion needs at least one Action")]
fn zero_action_count_rejects() {
    let mut w = witness_4(0, 0);
    w.effects.compact_actions = [[0u8; 148]; 4];
    w.action_index = 0;
    let _ = crate::transactions::effects::verify_transaction(w, HASH);
}
#[test(should_fail_with = "Action count exceeds capacity")]
fn action_count_above_capacity_rejects() {
    let _ = verify_action(witness_2(0, 3), HASH);
}
#[test(should_fail_with = "Nullifier mismatch")]
fn other_action_nullifier_rejects() {
    verify_nullifier_inclusion(witness_4(0, 2), nf(ACTION_1), HASH);
}
