    assert(
        crate::memo::aead::poly1305(
            std::hint::black_box([[255u8; 16]; 1]),
            std::hint::black_box([255u8; 32]),
        )
            == [251, 255, 255, 23, 250, 255, 255, 23, 250, 255, 255, 23, 250, 255, 255, 23],
    );
}
