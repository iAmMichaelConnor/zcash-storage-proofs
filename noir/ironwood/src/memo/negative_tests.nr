// The prepare-memo-fixtures block: one V6 transaction (tx_count 1), so the
// header's Merkle root is the txid.
fn witness<let N: u32>(
    compact_actions: [[u8; 148]; N],
    memos_digest: [u8; 32],
    noncompact_digest: [u8; 32],
    txid: [u8; 32],
    action_index: u32,
) -> Inclusion<N, 32> {
    let mut header = [0u8; 1487];
    header[0] = 4;
    for i in 0..32 {
        header[36 + i] = txid[i];
    }
    header[140] = 253;
    header[141] = 64;
    header[142] = 5;
    Inclusion {
        effects: V6Effects {
            compact_actions,
            memos_digest,
            noncompact_digest,
            flags: 3,
            value_balance: [0; 8],
            transparent_digest: [0; 32],
            sapling_digest: [0; 32],
            orchard_digest: [0; 32],
            lock_time: 0,
            expiry_height: 0,
        },
        header,
        siblings: [[0; 32]; 32],
        action_index,
        tx_index: 0,
        tx_count: 1,
        action_count: N,
    }
}
