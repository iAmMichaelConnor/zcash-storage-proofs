    global RAW_0_WITH_V1_PK_D: [u8; 43] = [
        109, 56, 75, 131, 120, 10, 200, 154, 26, 128, 200, 64, 104, 7, 62, 114, 68, 34, 87, 102, 56,
        36, 170, 70, 63, 43, 246, 127, 181, 83, 116, 103, 146, 45, 130, 2, 247, 9, 8, 198, 11, 130,
        44,
