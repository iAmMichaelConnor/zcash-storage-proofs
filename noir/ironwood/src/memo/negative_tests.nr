    let (w, full, hash) = tag_last_byte();
    let _ = crate::memo::verify_memo_created_in_block(note_0(), RAW_0, MEMO_0, w, full, hash);
}
#[test(should_fail_with = "Ephemeral key does not match note randomness")]
