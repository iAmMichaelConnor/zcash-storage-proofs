    global RAW_0_WITH_G_D_AS_PK_D: [u8; 43] = [
        109, 56, 75, 131, 120, 10, 200, 154, 26, 128, 200, 193, 29, 235, 110, 2, 226, 246, 51, 230,
        132, 103, 184, 202, 6, 222, 154, 249, 137, 165, 255, 66, 80, 214, 158, 44, 220, 134, 250, 6,
