// The same two-Action transaction in a capacity-4 buffer: slots 2 and 3 zero.
fn padded() -> (V6Effects<4>, [FullActionCiphertext; 4]) {
    let (e, f) = inputs();
    let empty = FullActionCiphertext {
        encrypted_note: [0u8; 580],
        value_commitment: [0u8; 32],
        randomized_key: [0u8; 32],
        outgoing_ciphertext: [0u8; 80],
    };
    let effects = V6Effects {
        compact_actions: [e.compact_actions[0], e.compact_actions[1], [0u8; 148], [0u8; 148]],
        memos_digest: e.memos_digest,
        noncompact_digest: e.noncompact_digest,
        flags: e.flags,
        value_balance: e.value_balance,
        transparent_digest: e.transparent_digest,
        sapling_digest: e.sapling_digest,
        orchard_digest: e.orchard_digest,
        lock_time: e.lock_time,
        expiry_height: e.expiry_height,
    };
    (effects, [f[0], f[1], empty, empty])
}
#[test]
fn complete_ordered_digest_preimages() {
    let (e, f) = std::hint::black_box(inputs());
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test(should_fail_with = "Memo ciphertext digest mismatch")]
fn reordered_actions_reject_even_when_compact_prefixes_match() {
    let (mut e, f) = std::hint::black_box(inputs());
    e.compact_actions = [e.compact_actions[1], e.compact_actions[0]];
    crate::memo::verify_ciphertext_digests(e, 2, [f[1], f[0]]);
}
#[test(should_fail_with = "Memo ciphertext digest mismatch")]
fn unselected_action_memo_tampering_rejects() {
    let (e, mut f) = std::hint::black_box(inputs());
    f[1].encrypted_note[52] = f[1].encrypted_note[52] ^ 1;
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test(should_fail_with = "Noncompact Action digest mismatch")]
fn unselected_action_tag_tampering_rejects() {
    let (e, mut f) = std::hint::black_box(inputs());
    f[1].encrypted_note[564] = f[1].encrypted_note[564] ^ 1;
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test]
fn two_actions_verify_in_a_larger_capacity() {
    let (e, f) = std::hint::black_box(padded());
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test(should_fail_with = "Nonzero unused Action ciphertext")]
fn truncated_action_count_rejects() {
    let (e, f) = std::hint::black_box(inputs());
    crate::memo::verify_ciphertext_digests(e, 1, f);
}
#[test(should_fail_with = "Nonzero unused Action ciphertext")]
fn nonzero_unused_ciphertext_prefix_rejects() {
    let (e, mut f) = std::hint::black_box(padded());
    f[2].encrypted_note[0] = 1;
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test(should_fail_with = "Nonzero bounded hash padding")]
fn nonzero_unused_memo_bytes_reject() {
    let (e, mut f) = std::hint::black_box(padded());
    f[3].encrypted_note[100] = 1;
    crate::memo::verify_ciphertext_digests(e, 2, f);
}
#[test(should_fail_with = "Action count exceeds capacity")]
fn action_count_above_capacity_rejects() {
    let (e, f) = std::hint::black_box(inputs());
    crate::memo::verify_ciphertext_digests(e, 3, f);
}
