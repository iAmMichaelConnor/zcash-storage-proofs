fn large_compact_counts_open_history() {
    let s = open(
        header(LARGE_COMMIT),
        LARGE_HASH,
        3428151,
        false,
        LARGE_NODE,
        AUTH,
    );
    assert(s.root == ROOT_43);
}
#[test]
fn equal_history_range_parses() {
    let m = parse_v3(black_box(EQUAL_NODE));
    assert(m.start_height == m.end_height);
}
// Companion of the Equihash prefix tests: the changed headers hash to the
// supplied values, so header_hash's prefix asserts are the only failure.
#[test]
fn equihash_prefix_variants_hash_as_supplied() {
    let mut h140 = header(MAINNET_COMMIT);
    h140[140] = 254;
    assert(sha256::digest(sha256::digest(black_box(h140))) == EQUIHASH_140_HASH);
    let mut h141 = header(MAINNET_COMMIT);
    h141[141] = 65;
    assert(sha256::digest(sha256::digest(black_box(h141))) == EQUIHASH_141_HASH);
    let mut h142 = header(MAINNET_COMMIT);
    h142[142] = 6;
    assert(sha256::digest(sha256::digest(black_box(h142))) == EQUIHASH_142_HASH);
}

#[test(should_fail_with = "Header hash mismatch")]
fn changed_header_byte_rejects() {
    let mut h = header(MAINNET_COMMIT);
    h[0] = h[0] ^ 1;
    let _ = open(h, MAINNET_HASH, 3428151, false, MAINNET_NODE, AUTH);
}
#[test(should_fail_with = "Header hash mismatch")]
fn changed_expected_hash_rejects() {
    let mut hash = MAINNET_HASH;
    hash[0] = hash[0] ^ 1;
    let _ = open(
        header(MAINNET_COMMIT),
        hash,
        3428151,
        false,
        MAINNET_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "Block commitment opening mismatch")]
fn changed_history_node_rejects() {
    let mut node = MAINNET_NODE;
    node[0] = node[0] ^ 1;
    let _ = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428151,
        false,
        node,
        AUTH,
    );
}
#[test(should_fail_with = "Block commitment opening mismatch")]
fn changed_auth_root_rejects() {
    let mut auth = AUTH;
    auth[0] = auth[0] ^ 1;
    let _ = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428151,
        false,
        MAINNET_NODE,
        auth,
    );
}
// The header commits to the mainnet node digested under another branch id.
#[test(should_fail_with = "Block commitment opening mismatch")]
fn wrong_branch_personalisation_rejects() {
    let _ = open(
        header(BRANCH_COMMIT),
        BRANCH_HASH,
        3428151,
        false,
        BRANCH_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "History height does not precede header")]
fn wrong_header_height_rejects() {
    let _ = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428152,
        false,
        MAINNET_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "Wrong history epoch start")]
fn wrong_epoch_start_rejects() {
    let _ = open(
        header(EPOCH_COMMIT),
        EPOCH_HASH,
        3428151,
        false,
        EPOCH_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "Wrong history epoch start")]
fn testnet_history_as_mainnet_rejects() {
    let _ = open(
        header(TESTNET_COMMIT),
        TESTNET_HASH,
        4134001,
        false,
        TESTNET_NODE,
        AUTH,
    );
}
// The activation assert is implied by the later ones (start == activation,
// end == height - 1, start <= end). Deleting it changes only which message
// rejects these inputs; no input's accept/reject outcome can detect it.
#[test(should_fail_with = "NU6.3 history starts after activation header")]
fn mainnet_history_as_testnet_rejects() {
    let _ = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428151,
        true,
        MAINNET_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "NU6.3 history starts after activation header")]
fn activation_header_itself_rejects() {
    let _ = open(
        header(ACTIVATION_COMMIT),
        ACTIVATION_HASH,
        3428143,
        false,
        ACTIVATION_NODE,
        AUTH,
    );
}
#[test(should_fail_with = "Descending history range")]
fn descending_history_range_rejects() {
    let _ = parse_v3(black_box(DESCENDING_NODE));
}
#[test(should_fail_with = "Descending history range")]
fn descending_history_range_rejects_in_header_opening() {
    let _ = open(
        header(DESCENDING_COMMIT),
        DESCENDING_HASH,
        3428151,
        false,
        DESCENDING_NODE,
        AUTH,
    );
}
// The nonzero byte is after the node length, so the commitment still matches.
// hash_variable_last_block's "Nonzero hash padding" is a second, later guard.
#[test(should_fail_with = "Nonzero history padding")]
fn nonzero_history_padding_rejects() {
    let mut node = MAINNET_NODE;
    node[316] = 1;
    let _ = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428151,
        false,
        node,
        AUTH,
    );
}
#[test(should_fail_with = "Noncanonical CompactSize u64")]
fn aliased_epoch_start_with_matching_hashes_rejects() {
    let _ = open(
        header(ALIAS_COMMIT),
        ALIAS_HASH,
        3428151,
        false,
        ALIAS_NODE,
        AUTH,
    );
}
// Each changed header's hash is supplied (see the companion test) and the
// history is the mainnet control, so only header_hash's prefix assert fails.
#[test(should_fail_with = "Equihash solution size byte 140 is not 0xfd")]
fn equihash_prefix_byte_140_rejects() {
    let mut h = header(MAINNET_COMMIT);
    h[140] = 254;
    let _ = open(h, EQUIHASH_140_HASH, 3428151, false, MAINNET_NODE, AUTH);
}
#[test(should_fail_with = "Equihash solution size byte 141 is not 0x40")]
fn equihash_prefix_byte_141_rejects() {
    let mut h = header(MAINNET_COMMIT);
    h[141] = 65;
    let _ = open(h, EQUIHASH_141_HASH, 3428151, false, MAINNET_NODE, AUTH);
}
#[test(should_fail_with = "Equihash solution size byte 142 is not 0x05")]
fn equihash_prefix_byte_142_rejects() {
    let mut h = header(MAINNET_COMMIT);
    h[142] = 6;
    let _ = open(h, EQUIHASH_142_HASH, 3428151, false, MAINNET_NODE, AUTH);
}
// parse_v3's messageless `end >= 277` and `end <= 317` follow from the parse
// itself (minimum and maximum CompactSize widths; read checks the buffer
// bound), so no input reaches them and they have no test.

#[test]
fn hash_tail_accepts_length_257() {
    assert(tail(TAIL_257, 257) == TAIL_257_DIGEST);
}
#[test]
fn hash_tail_accepts_length_277() {
    assert(tail(TAIL_277, 277) == TAIL_277_DIGEST);
}
#[test]
fn hash_tail_accepts_length_285() {
    assert(tail(TAIL_285, 285) == TAIL_285_DIGEST);
}
#[test]
fn hash_tail_accepts_length_309() {
    assert(tail(TAIL_309, 309) == TAIL_309_DIGEST);
}
#[test]
fn hash_tail_accepts_length_317() {
    assert(tail(TAIL_317, 317) == TAIL_317_DIGEST);
}
#[test]
fn hash_tail_accepts_zero_message_277() {
    assert(tail([0; 317], 277) == ZERO_277_DIGEST);
}
#[test(should_fail_with = "Length changes final block index")]
fn hash_tail_rejects_length_256() {
    let _ = tail(TAIL_257, 256);
}
#[test(should_fail_with = "Length exceeds buffer")]
fn hash_tail_rejects_length_318() {
    let _ = tail(TAIL_317, 318);
}
#[test(should_fail_with = "Nonzero hash padding")]
fn hash_tail_rejects_nonzero_padding() {
    let mut message = [0; 317];
    message[300] = 1;
    let _ = tail(message, 277);
}

#[test]
fn compact_size_reads_0() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([0, 0, 0, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 0);
    assert(end == 1);
}
#[test]
fn compact_size_reads_252() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([252, 0, 0, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 252);
    assert(end == 1);
}
#[test]
fn compact_size_reads_253() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([253, 253, 0, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 253);
    assert(end == 3);
}
#[test]
fn compact_size_reads_65535() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([253, 255, 255, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 65535);
    assert(end == 3);
}
#[test]
fn compact_size_reads_65536() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([254, 0, 0, 1, 0, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 65536);
    assert(end == 5);
}
#[test]
fn compact_size_reads_4294967295() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([254, 255, 255, 255, 255, 0, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 4294967295);
    assert(end == 5);
}
#[test]
fn compact_size_reads_4294967296() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([255, 0, 0, 0, 0, 1, 0, 0, 0]),
        black_box(0),
    );
    assert(value == 4294967296);
    assert(end == 9);
}
#[test]
fn compact_size_reads_18446744073709551615() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([255, 255, 255, 255, 255, 255, 255, 255, 255]),
        black_box(0),
    );
    assert(value == 18446744073709551615);
    assert(end == 9);
}
// 252 in the u16 form; the canonical form is compact_size_reads_252.
#[test(should_fail_with = "Noncanonical CompactSize u16")]
fn compact_size_rejects_u16_alias() {
    let _ = compact_size::read(
        black_box::<[u8; 9]>([253, 252, 0, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
}
// 65535 in the u32 form; the canonical form is compact_size_reads_65535.
#[test(should_fail_with = "Noncanonical CompactSize u32")]
fn compact_size_rejects_u32_alias() {
    let _ = compact_size::read(
        black_box::<[u8; 9]>([254, 255, 255, 0, 0, 0, 0, 0, 0]),
        black_box(0),
    );
}
// 4294967295 in the u64 form; the canonical form is compact_size_reads_4294967295.
#[test(should_fail_with = "Noncanonical CompactSize u64")]
fn compact_size_rejects_u64_alias() {
    let _ = compact_size::read(
        black_box::<[u8; 9]>([255, 255, 255, 255, 255, 0, 0, 0, 0]),
        black_box(0),
    );
}
#[test]
fn compact_size_reads_last_offset() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 9]>([0, 0, 0, 0, 0, 0, 0, 0, 0]),
        black_box(8),
    );
    assert(value == 0);
    assert(end == 9);
}
#[test(should_fail_with = "CompactSize offset outside input")]
fn compact_size_rejects_offset_outside_input() {
    let _ = compact_size::read(
        black_box::<[u8; 9]>([0, 0, 0, 0, 0, 0, 0, 0, 0]),
        black_box(9),
    );
}
#[test]
fn compact_size_reads_u64_ending_at_buffer_end() {
    let (value, end) = compact_size::read(
        black_box::<[u8; 10]>([0, 255, 0, 0, 0, 0, 1, 0, 0, 0]),
        black_box(1),
    );
    assert(value == 4294967296);
    assert(end == 10);
}
// The same u64 with its last byte missing.
#[test(should_fail_with = "Truncated CompactSize")]
fn compact_size_rejects_truncated_u64() {
    let _ = compact_size::read(
        black_box::<[u8; 9]>([0, 255, 0, 0, 0, 0, 1, 0, 0]),
        black_box(1),
    );
}
