fn header(commit: [u8; 32]) -> [u8; 1487] {
    let mut out = HEADER_BASE;
    for i in 0..32 {
        out[68 + i] = commit[i];
    }
    out
}

fn open(
    bytes: [u8; 1487],
    hash: [u8; 32],
    height: u32,
    is_testnet: bool,
    node: [u8; 317],
    auth: [u8; 32],
) -> LatestSnapshot {
    verify_header_latest(
        black_box(bytes),
        black_box(hash),
        black_box(height),
        black_box(is_testnet),
        black_box(node),
        black_box(auth),
    )
}

fn tail(message: [u8; 317], length: u32) -> [u8; 32] {
    hash_variable_last_block::<317, 32>(black_box(message), black_box(length), PERSONAL)
}

// Positive controls. Every negative below starts from one of these inputs.
#[test]
fn mainnet_header_opens_history() {
    let s = open(
        header(MAINNET_COMMIT),
        MAINNET_HASH,
        3428151,
        false,
        MAINNET_NODE,
        AUTH,
    );
    assert(s.root == ROOT_43);
    assert(s.height == 3428150);
}
#[test]
fn testnet_first_post_activation_header_opens_history() {
    let s = open(
        header(TESTNET_COMMIT),
        TESTNET_HASH,
        4134001,
        true,
        TESTNET_NODE,
        AUTH,
    );
    assert(s.root == ROOT_43);
    assert(s.height == 4134000);
}
#[test]
fn mainnet_first_post_activation_header_opens_history() {
    let s = open(
        header(ACTIVATION_COMMIT),
        ACTIVATION_HASH,
        3428144,
        false,
        ACTIVATION_NODE,
        AUTH,
    );
    assert(s.height == 3428143);
}
