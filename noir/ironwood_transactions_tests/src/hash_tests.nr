fn message(length: u32) -> [u8; 296] {
    let mut m = [0u8; 296];
    for i in 0..296 {
        if i < length {
            m[i] = DATA[i];
        }
    }
    m
}
fn bounded(m: [u8; 296], length: u32) -> [u8; 32] {
    hash_bounded::<296, 32>(black_box(m), black_box(length), PERSONAL)
}
// The first count slots hold the active DATA bytes; the other slots are zero.
fn actions(count: u32) -> [[u8; 148]; 2] {
    let m = message(148 * count);
    let mut a = [[0u8; 148]; 2];
    for i in 0..2 {
        for j in 0..148 {
            a[i][j] = m[148 * i + j];
        }
    }
    a
}
fn compact(a: [[u8; 148]; 2], count: u32) -> [u8; 32] {
    compact_digest_bounded::<2>(black_box(a), black_box(count))
}
fn four_bytes() -> Blake2b {
    let mut h = black_box(Blake2b::new_personalized::<32>(PERSONAL));
    h.update_at::<0, 4>(black_box([1, 2, 3, 4]));
    h
}

#[test]
fn hash_bounded_length_129_matches_hashlib() {
    assert(bounded(message(black_box(129)), 129) == D129);
}
#[test(should_fail_with = "Hash length exceeds capacity")]
fn hash_bounded_length_297_rejects() {
    let _ = bounded([0u8; 296], 297);
}
#[test(should_fail_with = "Nonzero bounded hash padding")]
fn hash_bounded_nonzero_byte_after_length_128_rejects() {
    let mut m = message(128);
    m[128] = 1;
    let _ = bounded(m, 128);
}
// The three "Incorrect transcript position" sites in ironwood hashes/blake2b.nr: each
// call claims a position other than the bytes already absorbed.
#[test(should_fail_with = "Incorrect transcript position")]
fn update_at_wrong_position_rejects() {
    let mut h = black_box(Blake2b::new_personalized::<32>(PERSONAL));
    h.update_at::<1, 4>(black_box([1, 2, 3, 4]));
}
#[test(should_fail_with = "Incorrect transcript position")]
fn finalize_at_wrong_position_rejects() {
    let _ = four_bytes().finalize_at::<5>();
}
#[test(should_fail_with = "Incorrect transcript position")]
fn finalize_last_block_at_wrong_position_rejects() {
    let _ = four_bytes().finalize_last_block_at::<5>(black_box(4));
}
#[test]
fn compact_digest_count_1_matches_hashlib() {
    assert(compact(actions(1), 1) == D148);
}
// The count check precedes the BLAKE2b "Hash length exceeds capacity" check
// (148 * count > 296), which would also reject it; the message pins it.
#[test(should_fail_with = "Compact Action count exceeds digest capacity")]
fn compact_digest_count_above_capacity_rejects() {
    let _ = compact([[0u8; 148]; 2], 3);
}

