global MACT: u32 = 3428143;

fn scan2(bytes: [u8; 3648], nf: [u8; 32], tip: [u8; 32], height: u32, testnet: bool) {
    nullifier_absence::from_activation(
        encoding::blocks::<2, 1, 1, 3648>(bytes),
        nf,
        tip,
        height,
        testnet,
    );
}
fn legacy2(bytes: [u8; 3800], nf: [u8; 32], tip: [u8; 32], height: u32, testnet: bool) {
    legacy::from_activation(
        encoding::mixed_blocks::<2, 1, 1, 72, 3800>(bytes),
        nf,
        tip,
        height,
        testnet,
    );
}
fn wide() -> [nullifier_absence::BlockEffects<4, 2>; 2] {
    encoding::blocks::<2, 4, 2, 6830>(WIDE)
}
fn scan_wide(blocks: [nullifier_absence::BlockEffects<4, 2>; 2]) {
    nullifier_absence::from_activation(blocks, NF, WIDE_TIP, MACT + 1, false);
}
fn wide_mixed() -> [legacy::Block<4, 2, 256>; 2] {
    encoding::mixed_blocks::<2, 4, 2, 256, 8910>(WIDE_MIXED)
}
fn legacy_wide(blocks: [legacy::Block<4, 2, 256>; 2]) {
    legacy::from_activation(blocks, NF, WIDE_MIXED_TIP, MACT + 1, false);
}
fn clean2() -> [nullifier_absence::BlockEffects<1, 1>; 2] {
    encoding::blocks::<2, 1, 1, 3648>(CLEAN)
}
fn clean2_mixed() -> [legacy::Block<1, 1, 72>; 2] {
    encoding::mixed_blocks::<2, 1, 1, 72, 3800>(CLEAN_MIXED)
}
fn clean3() -> [legacy::Block<1, 1, 72>; 3] {
    encoding::mixed_blocks::<3, 1, 1, 72, 5700>(CLEAN3_MIXED)
}
// The two blocks after C3_0, and the state that has scanned C3_0.
fn after_c0() -> [legacy::Block<1, 1, 72>; 2] {
    let c = clean3();
    [c[1], c[2]]
}
fn at_c0() -> nullifier_absence_state::State {
    nullifier_absence_state::State {
        queried_nf: NF,
        tip_hash: C3_0,
        height: MACT,
        is_testnet: false,
        activation_height: MACT,
    }
}
fn flip(hash: [u8; 32]) -> [u8; 32] {
    let mut h = hash;
    h[0] ^= 1;
    h
}

#[test]
fn wide_window_with_v5_and_empty_v6_accepted() {
    scan_wide(wide());
}
#[test(should_fail_with = "Incomplete transaction coverage")]
fn omitted_transaction_rejected() {
    let mut b = wide();
    b[1].transaction_count = 2;
    scan_wide(b);
}
// complete_block checks the count before merkle::complete_root's own
// count > 0 assert, which would also reject it; the message pins it.
#[test(should_fail_with = "V5/V6 scan block has no transactions")]
fn empty_block_rejected() {
    let mut b = wide();
    b[0].transaction_count = 0;
    scan_wide(b);
}
// complete_block checks the count before merkle::complete_root's own
// count <= MAX_TX assert, which would also reject it; the message pins it.
#[test(should_fail_with = "V5/V6 scan block exceeds transaction capacity")]
fn block_count_above_capacity_rejected() {
    let mut b = wide();
    b[0].transaction_count = 5;
    scan_wide(b);
}
// The row check precedes compact_digest_bounded's count check and the BLAKE2b
// length check, which would also reject it; the message pins the row check.
#[test(should_fail_with = "Transaction Action count exceeds row capacity")]
fn action_count_above_capacity_rejected() {
    let mut b = wide();
    b[1].transactions[1].action_count = 3;
    scan_wide(b);
}
#[test(should_fail_with = "Scan supports only V5/V6 transactions")]
fn v4_row_in_v5_v6_scan_rejected() {
    let mut b = wide();
    b[1].transactions[0].version = 4;
    scan_wide(b);
}
#[test(should_fail_with = "V5 cannot contain Ironwood Actions")]
fn v5_with_action_rejected() {
    let mut b = wide();
    b[0].transactions[0].action_count = 1;
    scan_wide(b);
}
#[test(should_fail_with = "Nonzero unused Action slot")]
fn nonzero_unused_action_slot_rejected() {
    let mut b = wide();
    b[0].transactions[0].effects.compact_actions[1][0] = 1;
    scan_wide(b);
}
#[test(should_fail_with = "Reserved Ironwood flags")]
fn scan_reserved_flags_rejected() {
    let mut b = wide();
    b[1].transactions[1].effects.flags = 8;
    scan_wide(b);
}
// Repeating the last transaction gives the same root (CVE-2012-2459 shape).
#[test(should_fail_with = "Duplicate transaction id")]
fn duplicated_last_transaction_rejected() {
    let mut b = wide();
    b[1].transaction_count = 4;
    b[1].transactions[3] = b[1].transactions[2];
    scan_wide(b);
}
#[test(should_fail_with = "Nonzero unused transaction leaf")]
fn complete_root_nonzero_unused_leaf_rejected() {
    let mut leaves = LEAVES;
    leaves[3] = [0; 32];
    leaves[3][0] = 1;
    let _ = merkle::complete_root::<4>(leaves, 3);
}
#[test(should_fail_with = "Transaction capacity must be a power of two")]
fn complete_root_capacity_three_rejected() {
    let _ = merkle::complete_root::<3>([LEAVES[0], LEAVES[1], LEAVES[2]], 3);
}
#[test(should_fail_with = "Scan must begin at Ironwood activation")]
fn tip_height_not_from_activation_rejected() {
    scan2(CLEAN, NF, CLEAN_TIP, MACT + 2, false);
}
// nullifier_absence.nr's "Scan height discontinuity" sits in continue_from_trusted_prior,
// which is pub(crate). from_activation asserts the same height relation first
// ("Scan must begin at Ironwood activation"), so the public API cannot reach it.
#[test(should_fail_with = "Broken scanned block link")]
fn broken_link_with_rehashed_tip_rejected() {
    let mut b = clean2();
    b[1].header[4] ^= 1;
    nullifier_absence::from_activation(b, NF, BROKEN_TIP, MACT + 1, false);
}
#[test(should_fail_with = "Scan tip does not match accepted checkpoint")]
fn wrong_tip_hash_rejected() {
    scan2(CLEAN, NF, flip(CLEAN_TIP), MACT + 1, false);
}
#[test]
fn wide_mixed_window_with_v4_accepted() {
    legacy_wide(wide_mixed());
}
#[test(should_fail_with = "Incomplete mixed transaction coverage")]
fn mixed_omitted_transaction_rejected() {
    let mut b = wide_mixed();
    b[1].transaction_count = 2;
    legacy_wide(b);
}
// legacy::complete_block checks the count before merkle::complete_root's own
// count > 0 assert, which would also reject it; the message pins it.
#[test(should_fail_with = "Mixed scan block has no transactions")]
fn mixed_empty_block_rejected() {
    let mut b = wide_mixed();
    b[0].transaction_count = 0;
    legacy_wide(b);
}
// legacy::complete_block checks the count before merkle::complete_root's own
// count <= MAX_TX assert, which would also reject it; the message pins it.
#[test(should_fail_with = "Mixed scan block exceeds transaction capacity")]
fn mixed_block_count_above_capacity_rejected() {
    let mut b = wide_mixed();
    b[0].transaction_count = 5;
    legacy_wide(b);
}
// With the raw bytes zero, no later check rejects a nonzero raw length.
#[test(should_fail_with = "Raw V4 length on a non-V4 row")]
fn non_v4_raw_length_rejected() {
    let mut b = wide_mixed();
    b[0].transactions[1].raw_length = 1;
    legacy_wide(b);
}
// The raw bytes of a non-V4 row are otherwise never hashed.
#[test(should_fail_with = "Raw V4 bytes on a non-V4 row")]
fn non_v4_raw_bytes_rejected() {
    let mut b = wide_mixed();
    b[0].transactions[1].raw_v4[0] = 1;
    legacy_wide(b);
}
#[test(should_fail_with = "Scan must begin at Ironwood activation")]
fn legacy_tip_height_not_from_activation_rejected() {
    legacy2(CLEAN_MIXED, NF, CLEAN_TIP, MACT + 2, false);
}
#[test(should_fail_with = "Broken scanned block link")]
fn legacy_broken_link_with_rehashed_tip_rejected() {
    let mut b = clean2_mixed();
    b[1].header[4] ^= 1;
    legacy::from_activation(b, NF, BROKEN_TIP, MACT + 1, false);
}
#[test(should_fail_with = "Scan tip does not match accepted checkpoint")]
fn legacy_wrong_tip_hash_rejected() {
    legacy2(CLEAN_MIXED, NF, flip(CLEAN_TIP), MACT + 1, false);
}
#[test]
fn advance_two_block_window_accepted() {
    let s = nullifier_absence_state::advance(at_c0(), after_c0(), 2, C3_2, MACT + 2);
    assert(s.tip_hash == C3_2);
    assert(s.height == MACT + 2);
    assert(s.queried_nf == NF);
    assert(!s.is_testnet);
    assert(s.activation_height == MACT);
}
#[test(should_fail_with = "Wrong scan initialization domain")]
fn wrong_initialization_domain_rejected() {
    let mut prior = at_c0();
    prior.activation_height = MACT + 1;
    let _ = nullifier_absence_state::advance(prior, after_c0(), 1, C3_1, MACT + 1);
}
// A prior below the pinned predecessor height, with the pinned hash as tip.
#[test(should_fail_with = "Prior scan precedes initialization")]
fn prior_before_initialization_rejected() {
    let mut prior = at_c0();
    prior.tip_hash = nullifier_absence::MAINNET_PRE_ACTIVATION_HASH;
    prior.height = MACT - 2;
    let c = clean3();
    let _ = nullifier_absence_state::advance(prior, [c[0], c[1]], 1, C3_0, MACT - 1);
}
#[test(should_fail_with = "Scan window height discontinuity")]
fn window_height_discontinuity_rejected() {
    let _ = nullifier_absence_state::advance(at_c0(), after_c0(), 1, C3_1, MACT + 2);
}
#[test(should_fail_with = "Broken scan window link")]
fn broken_window_link_rejected() {
    let mut prior = at_c0();
    prior.tip_hash = flip(C3_0);
    let _ = nullifier_absence_state::advance(prior, after_c0(), 1, C3_1, MACT + 1);
}
#[test(should_fail_with = "Scan window tip mismatch")]
fn window_tip_mismatch_rejected() {
    let _ = nullifier_absence_state::advance(at_c0(), after_c0(), 1, flip(C3_1), MACT + 1);
}
// With count 0 every other check holds: the tip and height are the prior's own.
#[test(should_fail_with = "Scan window advances zero blocks")]
fn empty_window_rejected() {
    let _ = nullifier_absence_state::advance(at_c0(), after_c0(), 0, C3_0, MACT);
}
// Count 3 with B = 2 would otherwise claim height MACT + 3 after checking two blocks.
#[test(should_fail_with = "Scan window count exceeds block capacity")]
fn window_count_above_capacity_rejected() {
    let _ = nullifier_absence_state::advance(at_c0(), after_c0(), 3, C3_2, MACT + 3);
}
// initialize checks the count before advance, whose own count check would
// also reject it; the message pins initialize's check.
#[test(should_fail_with = "Scan initialization covers zero blocks")]
fn initialize_empty_window_rejected() {
    let c = clean3();
    let _ = nullifier_absence_state::initialize(
        [c[0], c[1]],
        0,
        NF,
        nullifier_absence::MAINNET_PRE_ACTIVATION_HASH,
        MACT - 1,
        false,
    );
}

// More vectors. The positive of nullifier_absence_state::initialize is ironwood's own
// transactions/nullifier_absence/nullifier_absence_tests.nr honest_window_from_pin_accepted.
mod extended {
    use super::{
        at_c0, after_c0, clean3, legacy_wide, scan_wide, wide, wide_mixed, LEAVES, ROOT_1, ROOT_2,
        ROOT_3, ROOT_4, WIDE_MIXED_TIP, WIDE_NF_0, WIDE_NF_2, WIDE_TIP, C3_0, C3_1, MACT, NF,
        SPENT_MIXED, SPENT_TIP,
    };
    use ironwood::transactions::{
        encoding, legacy, merkle, nullifier_absence, nullifier_absence_state,
    };

    #[test(should_fail_with = "Queried nullifier occurs in scanned transaction")]
    fn second_action_nullifier_rejected() {
        nullifier_absence::from_activation(wide(), WIDE_NF_2, WIDE_TIP, MACT + 1, false);
    }
    // An omitted Action: the two-Action transaction opened with one Action
    // has another txid.
    #[test(should_fail_with = "Incomplete transaction coverage")]
    fn omitted_action_rejected() {
        let mut b = wide();
        b[1].transactions[1].action_count = 1;
        b[1].transactions[1].effects.compact_actions[1] = [0; 148];
        scan_wide(b);
    }
    #[test(should_fail_with = "Queried nullifier occurs in scanned transaction")]
    fn mixed_v6_nullifier_rejected() {
        legacy::from_activation(wide_mixed(), WIDE_NF_0, WIDE_MIXED_TIP, MACT + 1, false);
    }
    #[test(should_fail_with = "Incomplete mixed transaction coverage")]
    fn mixed_changed_v4_body_rejected() {
        let mut b = wide_mixed();
        b[0].transactions[0].raw_v4[79] ^= 1;
        legacy_wide(b);
    }
    // A V4 row relabelled as V5 keeps its raw bytes; legacy::txid's raw-length
    // check rejects it before the raw-bytes and coverage checks would.
    #[test(should_fail_with = "Raw V4 length on a non-V4 row")]
    fn mixed_v4_relabelled_v5_rejected() {
        let mut b = wide_mixed();
        b[0].transactions[0].effects.version = 5;
        legacy_wide(b);
    }
    #[test(should_fail_with = "Nonzero unused Action slot")]
    fn nonzero_unused_slot_of_v6_rejected() {
        let mut b = wide();
        b[0].transactions[1].effects.compact_actions[1][0] = 1;
        scan_wide(b);
    }
    #[test]
    fn complete_root_counts_1_to_4_match_hashlib() {
        let z = [0u8; 32];
        assert(merkle::complete_root::<4>([LEAVES[0], z, z, z], 1) == ROOT_1);
        assert(merkle::complete_root::<4>([LEAVES[0], LEAVES[1], z, z], 2) == ROOT_2);
        assert(merkle::complete_root::<4>([LEAVES[0], LEAVES[1], LEAVES[2], z], 3) == ROOT_3);
        assert(merkle::complete_root::<4>(LEAVES, 4) == ROOT_4);
    }
    // Count 1 of B = 2: the second block is ignored.
    #[test]
    fn advance_one_of_two_blocks_accepted() {
        let s = nullifier_absence_state::advance(at_c0(), after_c0(), 1, C3_1, MACT + 1);
        assert((s.tip_hash == C3_1) & (s.height == MACT + 1));
    }
    #[test]
    fn initialize_one_block_accepted() {
        let c = clean3();
        let s = nullifier_absence_state::initialize([c[0], c[1]], 1, NF, C3_0, MACT, false);
        assert((s.tip_hash == C3_0) & (s.height == MACT));
    }
    #[test(should_fail_with = "Wrong scan initialization domain")]
    fn prior_wrong_network_rejected() {
        let mut prior = at_c0();
        prior.is_testnet = true;
        let _ = nullifier_absence_state::advance(prior, after_c0(), 1, C3_1, MACT + 1);
    }
    #[test(should_fail_with = "Scan window height discontinuity")]
    fn initialize_forged_tip_height_rejected() {
        let c = clean3();
        let _ = nullifier_absence_state::initialize([c[0], c[1]], 1, NF, C3_0, MACT + 40, false);
    }
    #[test(should_fail_with = "Queried nullifier occurs in scanned transaction")]
    fn state_window_with_spend_rejected() {
        let _ = nullifier_absence_state::initialize(
            encoding::mixed_blocks::<2, 1, 1, 72, 3800>(SPENT_MIXED),
            2,
            NF,
            SPENT_TIP,
            MACT + 1,
            false,
        );
    }
}
