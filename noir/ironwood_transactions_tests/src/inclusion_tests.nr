#[test]
fn txid_v6_matches_hashlib() {
    assert(txid_v6(black_box(witness_2(0, 2).effects)) == TXID);
}
#[test]
fn ironwood_digest_matches_native_bundle_commitment() {
    assert(ironwood_digest(black_box(bundle_1())) == BUNDLE_COMMITMENT);
}
#[test(should_fail_with = "Reserved Ironwood flags")]
fn ironwood_digest_reserved_flags_rejects() {
    let mut e = bundle_1();
    e.flags = 8;
    let _ = ironwood_digest(black_box(e));
}
#[test(should_fail_with = "Reserved Ironwood flags")]
fn bounded_reserved_flags_rejects() {
    let mut w = witness_4(0, 2);
    w.effects.flags = 8;
    let _ = verify_action(w, HASH);
}
#[test(should_fail_with = "Unsupported effect digest version")]
fn header_digest_rejects_version_4() {
    let _ = header_digest(black_box(4), 7, 3428300);
}
#[test(should_fail_with = "Header hash mismatch")]
fn wrong_header_hash_rejects() {
    let mut h = HASH;
    h[0] ^= 1;
    let _ = verify_action(witness_4(0, 2), h);
}
#[test]
fn verify_output_opens_every_action_field() {
    let (a, txid) = verify_output(witness_4(1, 2), HASH, ACTION_1_CMX);
    assert(txid == TXID);
    assert(a.nullifier == nf(ACTION_1));
    assert(a.cmx == ACTION_1_CMX);
    assert(a.ephemeral_key == ACTION_1_EPK);
    assert(a.encrypted_note_prefix == ACTION_1_PREFIX);
}
#[test(should_fail_with = "Output commitment mismatch")]
fn other_action_commitment_rejects() {
    let _ = verify_output(witness_4(0, 2), HASH, ACTION_1_CMX);
}
#[test]
fn merkle_3_leaves_index_2_verifies() {
    merkle::verify(black_box(LEAF_2), black_box(PATH_3_2), 2, 3, ROOT_3);
}
// Index 3 of 3 with the duplicate-last path of index 2 reaches the same root,
// so only merkle::verify's index check rejects it.
#[test(should_fail_with = "Merkle leaf index beyond count")]
fn merkle_index_past_count_rejects() {
    merkle::verify(black_box(LEAF_2), black_box(PATH_3_2), 3, 3, ROOT_3);
}
#[test(should_fail_with = "Wrong duplicate-last sibling")]
fn merkle_wrong_duplicate_sibling_rejects() {
    let mut path = PATH_3_2;
    path[0][0] ^= 1;
    merkle::verify(black_box(LEAF_2), black_box(path), 2, 3, ROOT_3);
}
#[test(should_fail_with = "Nonzero unused Merkle sibling")]
fn merkle_nonzero_unused_sibling_rejects() {
    let mut path = PATH_1_0;
    path[2][0] = 1;
    merkle::verify(black_box(LEAF_0), black_box(path), 0, 1, ROOT_1);
}
#[test(should_fail_with = "Merkle path capacity too small")]
fn merkle_path_capacity_too_small_rejects() {
    let path = [PATH_5_0[0], PATH_5_0[1]];
    merkle::verify(black_box(LEAF_0), black_box(path), 0, 5, ROOT_5);
}
mod extended {
    use super::{
        BUNDLE_COMMITMENT, HASH, bundle_2, witness_4, LEAF_0, PATH_1_0, ROOT_1, LEAF_1, LEAF_4,
        LEAF_7, PATH_2_0, PATH_2_1, PATH_3_0, PATH_3_1, PATH_5_4, PATH_8_7, ROOT_2, ROOT_3, ROOT_5,
