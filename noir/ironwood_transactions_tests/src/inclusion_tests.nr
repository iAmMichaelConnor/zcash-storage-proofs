    #[test]
    fn merkle_8_leaves_index_7_verifies() {
        merkle::verify(black_box(LEAF_7), black_box(PATH_8_7), 7, 8, ROOT_8);
    }
    // merkle::verify checks count > 0 before index < count, which would also
    // reject count 0; the message pins the count check.
    #[test(should_fail_with = "Merkle path count is zero")]
    fn merkle_zero_count_rejects() {
        merkle::verify(black_box(LEAF_0), black_box(PATH_1_0), 0, 0, ROOT_1);
    }
    #[test]
    fn ironwood_digest_bounded_matches_native_bundle_commitment() {
        assert(ironwood_digest_bounded(black_box(bundle_2()), black_box(1)) == BUNDLE_COMMITMENT);
    }
