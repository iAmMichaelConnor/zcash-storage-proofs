        merkle::verify(black_box(LEAF_0), black_box(PATH_3_0), 0, 3, ROOT_3);
    }
    #[test]
    fn merkle_3_leaves_index_1_verifies() {
        merkle::verify(black_box(LEAF_1), black_box(PATH_3_1), 1, 3, ROOT_3);
    }
    #[test]
