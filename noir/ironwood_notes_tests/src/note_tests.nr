// Other vectors, bindings and repeated rejections. The
// positives of ownership::verify (via derive_owned) and of external vector 0
// of derive_with_commitment are in ironwood_slow_tests nullifier_tests.nr.
mod extended {
    use bigcurve::{BigCurve, Pallas};
    use bignum::{BigNum, Pallas_Fq as Fq, Pallas_Fr as Fr};
    use ironwood::notes::{commitment_x, NoteOpening, psi, rcm_v3};
    use ironwood::notes::nullifier::derive_with_commitment;
    use ironwood::notes::ownership::{verify, verify_viewing};
    use super::{
        note_0, gd_0, pkd_0, psi_0, rcm_0, cmx_0, nf_0, view_0, spend_0, note_1, gd_1, pkd_1, psi_1,
        rcm_1, cmx_1, nf_1, view_1, note_2, gd_2, pkd_2, psi_2, rcm_2, cmx_2, nf_2, view_2,
        note_int_0, cmx_int_0, nf_int_0, view_int_0, spend_int_0, note_int_1, cmx_int_1, nf_int_1,
        view_int_1, note_int_2, cmx_int_2, nf_int_2, view_int_2, check_reduce512, verify_viewing_0,
        verify_0,
    };

    fn check_prfs(
        note: NoteOpening,
        gd: [u8; 32],
        pkd: [u8; 32],
        expected_psi: Fq,
        expected_rcm: Fr,
    ) {
        assert(psi(note.rseed, note.rho).get_limbs() == expected_psi.get_limbs());
        assert(rcm_v3(note, gd, pkd, expected_psi).get_limbs() == expected_rcm.get_limbs());
    }
    #[test]
    fn psi_and_rcm_v3_match_native_vector_1() {
        check_prfs(note_1(), gd_1(), pkd_1(), psi_1(), rcm_1());
    }
    #[test]
    fn psi_and_rcm_v3_match_native_vector_2() {
        check_prfs(note_2(), gd_2(), pkd_2(), psi_2(), rcm_2());
    }
    #[test]
    fn psi_binds_rseed_and_rho() {
        let note = note_0();
        assert(
            psi(
                [
                    6, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7,
                    7, 7, 7, 7, 7,
                ],
                note.rho,
            )
                .get_limbs()
                != psi_0().get_limbs(),
        );
        assert(
            psi(note.rseed, Fq::from_limbs_unsafe([43, 0, 0])).get_limbs() != psi_0().get_limbs(),
        );
    }
    #[test]
    fn rcm_v3_binds_every_input() {
        let expected = rcm_0().get_limbs();
        let mut note = note_0();
        note.rseed[0] ^= 1;
        assert(rcm_v3(note, gd_0(), pkd_0(), psi_0()).get_limbs() != expected);
        let mut gd = gd_0();
        gd[0] ^= 1;
        assert(rcm_v3(note_0(), gd, pkd_0(), psi_0()).get_limbs() != expected);
        let mut pkd = pkd_0();
        pkd[0] ^= 1;
        assert(rcm_v3(note_0(), gd_0(), pkd, psi_0()).get_limbs() != expected);
        let mut note = note_0();
        note.value ^= 1;
        assert(rcm_v3(note, gd_0(), pkd_0(), psi_0()).get_limbs() != expected);
        let mut note = note_0();
        note.rho = Fq::from_limbs_unsafe([43, 0, 0]);
        assert(rcm_v3(note, gd_0(), pkd_0(), psi_0()).get_limbs() != expected);
        let psi_flip = Fq::from_limbs_unsafe([
            227043257276556815557229843371890962,
            877270356549804650340041539750330686,
            10617,
        ]);
        assert(rcm_v3(note_0(), gd_0(), pkd_0(), psi_flip).get_limbs() != expected);
    }

    #[test]
    fn commitment_x_matches_native_vector_1() {
        assert(commitment_x(note_1()).get_limbs() == cmx_1().get_limbs());
    }
    #[test]
    fn commitment_x_matches_native_vector_2() {
        assert(commitment_x(note_2()).get_limbs() == cmx_2().get_limbs());
    }
    #[test]
    fn commitment_x_binds_value() {
        let mut note = note_0();
        note.value ^= 1;
        assert(commitment_x(note).get_limbs() != cmx_0().get_limbs());
    }
    #[test]
    fn commitment_x_binds_rseed() {
        let mut note = note_0();
        note.rseed[0] ^= 1;
        assert(commitment_x(note).get_limbs() != cmx_0().get_limbs());
    }
    #[test]
    fn commitment_x_binds_rho() {
        let mut note = note_0();
        note.rho = Fq::from_limbs_unsafe([43, 0, 0]);
        assert(commitment_x(note).get_limbs() != cmx_0().get_limbs());
    }
    // The opening reaches the receiver and rho checks (old harness cases).
    #[test(should_fail_with = "Identity point has no encoding")]
    fn commitment_x_rejects_identity_g_d() {
        let mut note = note_0();
        note.receiver.g_d = Pallas::from_coordinates_unsafe(
            Fq::from_limbs_unsafe([
                506726495024124802061580032014292420,
                1100087709092214591573222379199338573,
                11946,
            ]),
            Fq::from_limbs_unsafe([
                628731850874629533683864477619069742,
                806417485615902811292462540950584515,
