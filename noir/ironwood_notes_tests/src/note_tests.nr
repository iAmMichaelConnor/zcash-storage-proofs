    }
    #[test(should_fail_with = "Identity point has no encoding")]
    fn commitment_x_rejects_identity_pk_d() {
        let mut note = note_0();
        note.receiver.pk_d = Pallas::from_coordinates_unsafe(
            Fq::from_limbs_unsafe([
                224552155349642981271532207037966400,
