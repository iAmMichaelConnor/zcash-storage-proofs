    #[test(should_fail_with = "call to assert_max_bit_size")]
    fn commitment_x_rejects_g_d_x_limb_2_pow_120() {
        let mut note = note_0();
        note.receiver.g_d = Pallas::from_coordinates_unsafe(
            Fq::from_limbs_unsafe([
