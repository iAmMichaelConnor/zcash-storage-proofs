    #[test(should_fail_with = "call to assert_max_bit_size")]
    fn commitment_x_rejects_rho_alias() {
        let mut note = note_0();
        note.rho = Fq::from_limbs_unsafe([366563674732566411551322322153504811, 34, 16384]);
        let _ = commitment_x(note);
